# Telepítő – nem kerül a repóba
setup.php

# Adatbázis: csak a séma kerül a repóba (a szerver telepítője ebből hozza létre és pótolja a táblákat),
# a frissítő SQL-ek nem – a mappa védőfájljai maradnak
sql/*
!sql/schema.sql
!sql/.htaccess
!sql/index.php

# Éles konfiguráció (adatbázis-jelszó) – minta: includes/config.example.php
includes/config.php

# Adatbázis-mentések (éles adatok) – a mappa védőfájljai maradnak
DBBCKP/*
!DBBCKP/.htaccess
!DBBCKP/index.php

# Tevékenységnaplók (felhasználók, IP-címek) – a mappa védőfájljai maradnak
LOG/*
!LOG/.htaccess
!LOG/index.php

# Rendszerfájlok
.DS_Store

# Frontend tesztek (Playwright) – csak helyben, nem kerülnek a repóba
tests/
docker-compose.teszt.yml
