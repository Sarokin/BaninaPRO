# Telepítő – nem kerül a repóba
setup.php

# Adatbázis: csak a séma kerül a repóba (a szerver telepítője ebből hozza létre és pótolja a táblákat),
# a frissítő SQL-ek nem – a mappa védőfájljai maradnak
sql/*
!sql/schema.sql
!sql/.htaccess
!sql/index.php

# Éles konfiguráció (adatbázis-jelszó) – minta: includes/config.example.php
includes/config.php

# Adatbázis-mentések (éles adatok) – a mappa védőfájljai maradnak
DBBCKP/*
!DBBCKP/.htaccess
!DBBCKP/index.php

# Tevékenységnaplók (felhasználók, IP-címek) – a mappa védőfájljai maradnak
LOG/*
!LOG/.htaccess
!LOG/index.php

# Rendszerfájlok
.DS_Store

# Helyi referenciapéldány (éles adatokkal, nem a repó része)
BaninaPRO_WEB/

# Frontend tesztek (Playwright) – csak helyben, nem kerülnek a repóba
tests/
docker-compose.teszt.yml

# A könyvelőprogram (IB System) Excel-exportjai (éles üzleti adatok: partnerek, összegek) – csak helyben, teszteléshez
SERVER SETUP AND UPDATE/*.xlsx

# SQL-mentések / exportok (éles adatok!) – a repó nyilvános, ilyen fájl soha nem kerülhet bele.
# (Az egyetlen kivétel a séma: sql/schema.sql – lásd fent.)
*.sql
*.sql.gz
*.sql.zip
!sql/schema.sql

# DOS + IB System migráció (MIGRACIO/): az eszközök és a leírások a repóban vannak. A bemenetek (DOS-mappa, IB-exportok,
# élő adatbázis-mentés), az eredmények és a valódi adatokon futott próbák éles üzleti adatok – soha nem kerülhetnek bele.
MIGRACIO/1_DOS_PROGRAM/*
MIGRACIO/2_IB_SYSTEM/*
MIGRACIO/3_BANINAPRO_ELO_ADATBAZIS/*
MIGRACIO/4_EREDMENY/*
!MIGRACIO/*/OLVASS_EL.txt
MIGRACIO/eszkozok/teszt/probak/
MIGRACIO/eszkozok/teszt/*.xlsx
MIGRACIO/eszkozok/teszt/*.json
!MIGRACIO/eszkozok/teszt/minta_koztes.json

# Python gyorsítótár (a migrációs eszközök futtatásakor keletkezhet)
__pycache__/
*.pyc
